<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_app_logo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/app_logo"
            android:scaleType="centerCrop"
            android:contentDescription="App Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end"
            android:paddingStart="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/notif_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02:35 م"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/notif_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العصر"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#D97706" />
            </LinearLayout>

            <TextView
                android:id="@+id/notif_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 جمادى الثاني 1448"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:paddingTop="1dp" />

            <TextView
                android:id="@+id/notif_countdown_hms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر بعد 00:12:03"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:paddingTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notif_prayer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="500"
        android:progressDrawable="@drawable/bg_prayer_progress" />
</LinearLayout>
